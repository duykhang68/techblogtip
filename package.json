{
  "name": "techblogtip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/write-release.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "lint:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "quality": "npm run check && npm run lint:content && npm test && npm run build && npm run verify:build"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3",
    "cf": "^1.0.0-beta.29"
  }
}
