{
  "name": "techblogtip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/defer-article-media.mjs && node scripts/write-release.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "lint:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "quality": "npm run check && npm run lint:content && npm test && npm run build && npm run verify:build && npm run seo:audit",
    "qa:visual": "node scripts/visual-qa.mjs",
    "publisher:test": "node --test tests/publisher-worker.test.mjs tests/publisher-progress.test.mjs tests/publisher-production-status.test.mjs tests/publisher-live-readonly-canary.test.mjs tests/publisher-release-proof.test.mjs",
    "qa:publisher": "node scripts/publisher/browser-e2e.mjs",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "cf": "^1.0.0-rc.1",
    "playwright-core": "^1.56.0"
  },
  "workspaces": [
    "workers/publisher"
  ]
}
