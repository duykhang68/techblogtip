---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles, categoryUrl, valuesWithCounts } from '../lib/content';
const articles = await getArticles();
const categories = valuesWithCounts(articles, a => [a.data.category]);
const maxPerPage = 8;
const pages = Math.ceil(articles.length / maxPerPage);
---
<BaseLayout title="TechBlogTip" description="Hướng dẫn công nghệ, thủ thuật máy tính, tin học văn phòng, AI và lập trình. Nội dung tiếng Việt dễ hiểu, đi thẳng vào giải pháp.">
  <section class="container homepage-heading">
    <div><p class="section-kicker">CÔNG NGHỆ · THỦ THUẬT · KIẾN THỨC</p><h1>Học công nghệ theo cách <em>đơn giản hơn.</em></h1><p>Hướng dẫn thực hành, mẹo hữu ích và các chủ đề đáng khám phá. Không vòng vo, bắt đầu ngay từ điều bạn cần biết.</p></div>
    <a class="home-search-link" href="/tim-kiem/"><span>Tìm trong thư viện kiến thức</span><span aria-hidden="true">⌕</span></a>
  </section>
  <section class="container topic-strip" aria-labelledby="topics-title"><div class="section-head"><h2 id="topics-title">Khám phá chuyên mục</h2><a href="/chuyen-muc/">Tất cả chuyên mục →</a></div><div class="topic-chips">{categories.map(item => <a href={categoryUrl(item.name)}>{item.name}<span>{item.count}</span></a>)}</div></section>
  <section class="container article-section" aria-labelledby="latest-title"><div class="section-head"><div><p class="section-kicker">ĐƯỢC CHỌN CHO BẠN</p><h2 id="latest-title">Bài viết mới nhất</h2></div><span class="issue-label">TẤT CẢ · {articles.length} BÀI</span></div><ArticleList articles={articles.slice(0,maxPerPage)} /><div class="pagination">{pages > 1 && <a href="/page/2/">Trang tiếp theo →</a>}</div></section>
</BaseLayout>
