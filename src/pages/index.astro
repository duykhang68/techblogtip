---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles, withBase } from '../lib/content';
const articles = await getArticles();
const maxPerPage = 8;
const pages = Math.ceil(articles.length / maxPerPage);
---
<BaseLayout title="TechBlogTip" description="Hướng dẫn công nghệ, thủ thuật máy tính, tin học văn phòng, AI và lập trình. Nội dung tiếng Việt dễ hiểu, đi thẳng vào giải pháp.">
  <section class="container article-section" aria-labelledby="latest-title">
    <div class="section-head"><div><h2 id="latest-title">Bài viết mới nhất</h2></div><span class="issue-label">TẤT CẢ · {articles.length} BÀI</span></div>
    <ArticleList articles={articles.slice(0,maxPerPage)} />
    <div class="pagination">{pages > 1 && <a href={withBase('/page/2/')}>Trang tiếp theo →</a>}</div>
  </section>
</BaseLayout>
