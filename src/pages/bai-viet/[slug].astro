---
import { getArticles, articleUrl, categoryUrl, tagUrl, seriesUrl, formatDate, withBase, type Article } from '../../lib/content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublisherStoryVisual from '../../components/PublisherStoryVisual.astro';
import SmartToc from '../../components/SmartToc.astro';
import ArticleVisualMap from '../../components/ArticleVisualMap.astro';
import EngineeringRulesVisual from '../../components/EngineeringRulesVisual.astro';
import RepoDeletionVisual from '../../components/RepoDeletionVisual.astro';
export async function getStaticPaths() {
  return (await getArticles()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Article };
const { Content, headings } = await render(post);
const showEngineeringRulesVisual = post.id.replace(/\.md$/, '') === 'techblogtip-engineering-rules';
const showRepoDeletionVisual = post.id.replace(/\.md$/, '') === 'xoa-nhieu-repository-github-cli-an-toan';
const showPublisherVisual = post.id.replace(/\.md$/, '') === 'hanh-trinh-xay-dung-google-sheets-publisher-techblogtip' && post.data.sourceType === 'google-sheets';
const related = (await getArticles()).filter(item => item.id !== post.id && (item.data.category === post.data.category || item.data.tags.some(t => post.data.tags.includes(t)))).slice(0,3);
const site = Astro.site || new URL(Astro.url.origin);
const canonical = new URL(articleUrl(post), site).toString();
const jsonLd = {
  '@context':'https://schema.org', '@type':'BlogPosting', headline:post.data.title,
  description:post.data.description, datePublished:post.data.published.toISOString(),
  ...(post.data.updated ? {dateModified:post.data.updated.toISOString()} : {}),
  author:{'@type':'Person',name:post.data.author},
  mainEntityOfPage:canonical, inLanguage:'vi-VN'
};
---
<BaseLayout title={post.data.title} description={post.data.description} canonicalPath={articleUrl(post)}>
  <div class="container article-top"><nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase('/')}>Trang chủ</a><span>/</span><a href={categoryUrl(post.data.category)}>{post.data.category}</a></nav><a class="eyebrow" href={categoryUrl(post.data.category)}>{post.data.category}</a><h1>{post.data.title}</h1><p class="article-lead">{post.data.description}</p><div class="article-byline"><strong>{post.data.author}</strong><span>·</span><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>{post.data.updated && <span>· Cập nhật {formatDate(post.data.updated)}</span>}</div></div>
  <div class="container article-layout"><article class="prose" id="article-body" data-publisher-source-id={post.data.sourceType === 'google-sheets' ? post.data.sourceId : undefined} data-publisher-source-revision={post.data.sourceType === 'google-sheets' ? post.data.sourceRevision : undefined}>{showPublisherVisual&&<PublisherStoryVisual variant="flow"/>}<ArticleVisualMap headings={headings}/>{showRepoDeletionVisual&&<RepoDeletionVisual/>}{showEngineeringRulesVisual&&<EngineeringRulesVisual variant="principles"/>}<Content />{showEngineeringRulesVisual&&<EngineeringRulesVisual variant="release"/>}{showPublisherVisual&&<PublisherStoryVisual variant="proof"/>}<div class="article-taxonomy">{post.data.tags.map(tag=><a href={tagUrl(tag)}>#{tag}</a>)}{post.data.series&&<a href={seriesUrl(post.data.series)}>Chủ đề: {post.data.series}</a>}</div></article>
    {headings.filter(h=>h.depth===2||h.depth===3).length>2&&<SmartToc headings={headings} />}
  </div>
  {related.length>0&&<section class="container related-section"><div class="section-head"><h2>Bài viết liên quan</h2><a href={categoryUrl(post.data.category)}>Xem chuyên mục →</a></div><div class="related-links">{related.map(item=><a href={articleUrl(item)}><span>{item.data.category}</span><strong>{item.data.title}</strong><span aria-hidden="true">↗</span></a>)}</div></section>}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
