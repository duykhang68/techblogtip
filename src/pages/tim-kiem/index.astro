---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/content';
---
<BaseLayout title="Tìm kiếm" description="Tìm thủ thuật, hướng dẫn và kiến thức công nghệ theo từ khóa trong thư viện TechBlogTip.">
  <section class="container list-page search-page">
    <p class="section-kicker">TÌM KIẾM · KHÔNG CẦN TÀI KHOẢN</p>
    <h1>Bạn đang muốn tìm gì?</h1>
    <p class="directory-summary">Tìm nhanh trong tiêu đề, mô tả, chuyên mục và thẻ của các bài viết.</p>
    <label for="search-input">Từ khóa</label>
    <input id="search-input" class="search-field" data-index-url={withBase('/search-index.json')} name="q" type="search" placeholder="Ví dụ: Google Sheets, Windows, Git..." autocomplete="off" />
    <p id="search-status" role="status" aria-live="polite">Nhập từ khóa để bắt đầu.</p>
    <ul id="search-results" class="search-results" aria-label="Kết quả tìm kiếm"></ul>
    <noscript>Vui lòng bật JavaScript để sử dụng tìm kiếm trong trình duyệt. Bạn vẫn có thể duyệt chuyên mục và RSS.</noscript>
  </section>
  <script>
    interface SearchItem { title:string; description:string; category:string; tags:string[]; url:string; published:string; }
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const status = document.querySelector<HTMLElement>('#search-status');
    const results = document.querySelector<HTMLUListElement>('#search-results');
    const normalize = (s:string) => s.toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');
    let items: SearchItem[] = [];
    let pending: Promise<SearchItem[]> | undefined;
    // Do not download the static search index until the visitor actually searches.
    const ensureIndex = () => {
      if (!pending) pending = fetch(input?.dataset.indexUrl || '/search-index.json')
        .then(r => { if (!r.ok) throw new Error('Không tải được danh sách tìm kiếm'); return r.json() as Promise<SearchItem[]>; })
        .then(data => { items = data; return data; })
        .catch(error => { pending = undefined; throw error; });
      return pending;
    };
    async function renderResults() {
      if (!input || !status || !results) return;
      const query = normalize(input.value.trim());
      const params = new URLSearchParams(window.location.search);
      if (query) params.set('q', input.value.trim()); else params.delete('q');
      history.replaceState(null,'',location.pathname+(params.toString()?'?'+params:''));
      results.replaceChildren();
      if (!query) { status.textContent='Nhập từ khóa để bắt đầu.'; return; }
      status.textContent = 'Đang tìm kiếm…';
      try { await ensureIndex(); }
      catch {
        if (query === normalize(input.value.trim())) status.textContent='Không tải được dữ liệu tìm kiếm. Vui lòng thử nhập lại.';
        return;
      }
      // Ignore stale async responses after the visitor edits or clears the input.
      if (query !== normalize(input.value.trim())) return;
      const tokens=query.split(/\s+/).filter(Boolean);
      const matches=items.filter(item=>tokens.every(token=>normalize([item.title,item.description,item.category,...item.tags].join(' ')).includes(token))).slice(0,30);
      status.textContent=matches.length+' kết quả';
      for (const item of matches) {
        const li=document.createElement('li');
        const a=document.createElement('a'); a.href=item.url;
        const category=document.createElement('span'); category.className='eyebrow'; category.textContent=item.category;
        const h=document.createElement('strong'); h.textContent=item.title;
        const p=document.createElement('p'); p.textContent=item.description;
        a.append(category,h,p); li.append(a); results.append(li);
      }
    }
    if (input) {
      input.value=new URLSearchParams(location.search).get('q')||'';
      let debounce: ReturnType<typeof setTimeout> | undefined;
      input.addEventListener('input', () => { if (debounce) clearTimeout(debounce); debounce=setTimeout(() => { void renderResults(); },120); });
      if (input.value.trim()) void renderResults();
    }
  </script>
</BaseLayout>
