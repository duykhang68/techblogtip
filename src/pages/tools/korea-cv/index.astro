---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/content';
const sections = [
  {id:'personal', title:'01 · 인적사항 / Thông tin cá nhân', fields:[['koreanName','Họ tên tiếng Hàn'],['englishName','Họ tên Latin'],['hanjaName','Tên Hanja (không bắt buộc)'],['email','Email'],['phone','Điện thoại'],['address','Địa chỉ (không bắt buộc)'],['preferredLocation','Nơi làm việc mong muốn'],['availableFrom','Ngày có thể bắt đầu']]},
  {id:'education', title:'02 · 학력사항 / Học vấn', fields:[['school','Trường'],['degree','Bằng cấp'],['major','Chuyên ngành'],['from','Từ (YYYY.MM)'],['to','Đến (YYYY.MM)'],['gpa','Điểm / Thang điểm']]},
  {id:'employment', title:'03 · 경력사항 / Quá trình công tác', fields:[['employer','Công ty'],['position','Chức danh'],['from','Từ (YYYY.MM)'],['to','Đến (YYYY.MM)'],['responsibilities','Công việc'],['contractType','Loại hợp đồng']]},
  {id:'projects', title:'04 · 경력 사항 기술 / Dự án chuyên sâu', fields:[['name','Dự án'],['role','Vai trò'],['from','Từ'],['to','Đến'],['context','Bối cảnh / phạm vi'],['actions','Công việc thực hiện'],['results','Kết quả có bằng chứng']]},
  {id:'certifications', title:'05 · 자격 / Chứng chỉ', fields:[['name','Chứng chỉ'],['level','Cấp độ'],['date','Ngày đạt']]},
  {id:'languages', title:'06 · 어학 / Ngoại ngữ', fields:[['language','Ngôn ngữ'],['test','Kỳ thi'],['score','Điểm / Trình độ'],['date','Ngày thi']]},
  {id:'skills', title:'07 · Skills / Kỹ năng', fields:[['name','Kỹ năng']]},
  {id:'awards', title:'08 · Awards / Giải thưởng', fields:[['name','Giải thưởng'],['date','Thời điểm']]},
  {id:'training', title:'09 · Training / Đào tạo', fields:[['name','Khóa học'],['date','Thời gian']]},
  {id:'patents', title:'10 · Patents / Sáng chế', fields:[['name','Sáng chế'],['number','Số đăng ký']]},
  {id:'referees', title:'11 · Referees / Người tham chiếu', fields:[['name','Họ tên (có sự đồng ý)'],['role','Vai trò'],['contact','Liên hệ']]},
  {id:'research', title:'12 · 연구(논문)경력 / Nghiên cứu', fields:[['institution','Tổ chức'],['period','Thời gian'],['title','Đề tài'],['description','Mô tả']]},
];
const essays = [['growth','성장과정 · Quá trình trưởng thành'],['personality','성격 · Tính cách'],['schoolSocial','학교생활/사회생활 · Hoạt động học đường/xã hội'],['motivation','지원동기/이직사유 · Động lực ứng tuyển'],['future','입사 후 포부 · Mục tiêu sau khi gia nhập']];
---
<BaseLayout title="Korea CV Maker" description="Biểu mẫu CV Hàn Quốc theo cấu trúc sáu trang; lưu trữ riêng tư trên Google Drive khi kết nối được kích hoạt.">
  <div class="container kcv">
    <nav aria-label="Đường dẫn"><a href={withBase('/')}>Trang chủ</a> / <span>Korea CV Maker</span></nav>
    <header class="kcv-head">
      <p class="section-kicker">CAREER TOOLS · KOREA</p>
      <h1>Korea CV <span>Maker</span></h1>
      <p>Soạn hồ sơ ứng tuyển theo biểu mẫu Hàn Quốc. Lưu riêng tư trên Google Drive, quản lý nhiều công ty và xuất PDF hoặc Excel.</p>
      <p class="kcv-privacy">Biểu mẫu tham khảo, không đại diện cho bất kỳ nhà tuyển dụng nào. Không điền sẵn thông tin cá nhân.</p>
    </header>
    <div class="kcv-tabs" role="tablist" aria-label="Các bước thực hiện">
      <button type="button" id="input-tab" role="tab" aria-selected="true" aria-controls="input-panel"><span class="kcv-tab-step">01</span> Soạn hồ sơ</button>
      <button type="button" id="saved-tab" role="tab" aria-selected="false" aria-controls="saved-panel"><span class="kcv-tab-step">02</span> CV đã lưu &amp; xuất file</button>
    </div>
    <div class="kcv-toolbar" aria-label="Lưu trữ CV riêng tư">
      <div class="kcv-toolbar-heading">
        <span class="kcv-drive-icon" aria-hidden="true">✦</span>
        <div><strong>Không gian CV riêng tư</strong><small>Dữ liệu thuộc tài khoản Google của bạn</small></div>
      </div>
      <div class="kcv-toolbar-actions">
        <button type="button" id="kcv-connect" class="kcv-btn kcv-btn-primary"><span aria-hidden="true">G</span> Kết nối Google</button>
        <button type="button" id="kcv-new" class="kcv-btn kcv-btn-secondary" disabled>+ CV mới</button>
        <button type="button" id="kcv-save" class="kcv-btn kcv-btn-accent" disabled>Lưu CV</button>
        <button type="button" id="kcv-signout" class="kcv-btn kcv-btn-secondary" hidden>Ngắt kết nối</button>
      </div>
      <p id="service-status" class="kcv-status" role="status" aria-live="polite" data-state="neutral"><span class="kcv-status-dot" aria-hidden="true"></span>Chưa kết nối · Bạn vẫn có thể nhập CV và kết nối để lưu sau.</p>
    </div>
    <section id="input-panel" role="tabpanel" aria-labelledby="input-tab">
      <nav class="kcv-section-nav" aria-label="Chuyển nhanh đến phần cần nhập">
        <strong>Đi đến phần</strong>
        <a href="#cv-application">Ứng tuyển</a>
        <a href="#cv-section-personal">Thông tin cá nhân</a>
        <a href="#cv-section-education">Học vấn</a>
        <a href="#cv-section-employment">Kinh nghiệm</a>
        <a href="#cv-section-projects">Dự án</a>
        <a href="#cv-essays">Tự giới thiệu</a>
      </nav>
      <div class="kcv-panel" id="cv-application">
        <h2>Thông tin lần ứng tuyển</h2>
        <div class="kcv-fields">
          <label>Tên phiên bản CV<input name="label" autocomplete="off" placeholder="Ví dụ: CV ứng tuyển kỹ sư" /></label>
          <label>Công ty ứng tuyển<input name="targetCompany" autocomplete="off" placeholder="Để trống hoặc ABC" /></label>
          <label>Vị trí ứng tuyển<input name="targetRole" autocomplete="off" /></label>
          <label>Ngôn ngữ xuất<select name="locale"><option value="ko">한국어 / Korean</option><option value="vi">Tiếng Việt</option></select></label>
        </div>
      </div>
      {sections.map(section => <section class="kcv-panel" id={`cv-section-${section.id}`} data-section={section.id}>
        <div class="kcv-section-head"><h2>{section.title}</h2>{section.id !== 'personal' && <button type="button" class="kcv-add" data-add={section.id}>+ Thêm dòng</button>}</div>
        {section.id === 'referees' && <p>Chỉ nhập thông tin người tham chiếu khi được họ đồng ý.</p>}
        {section.id === 'personal' ? <div class="kcv-fields">{section.fields.map(([key, label]) => <label>{label}<input name={`personal.${key}`} autocomplete="off" /></label>)}</div> :
        <div class="kcv-rows" data-rows={section.id} data-fields={JSON.stringify(section.fields)}><p class="kcv-empty">Chưa có dữ liệu. Chọn “Thêm dòng”.</p></div>}
      </section>)}
      <section class="kcv-panel" id="cv-essays"><h2>13 · 자기소개서 / Năm câu hỏi tự giới thiệu</h2><div class="kcv-essays">{essays.map(([key,label]) => <label>{label}<textarea name={`essays.${key}`} rows="5" placeholder="Viết trải nghiệm thật; không tự tạo thành tích."></textarea></label>)}</div></section>
      <div class="kcv-actions"><button type="button" id="review-input">Xem trước hồ sơ</button><span>Bản xem tạm không được lưu. Hãy chọn “Kết nối Google Drive” rồi “Lưu lên Drive” để giữ dữ liệu.</span></div>
    </section>
    <section id="saved-panel" role="tabpanel" aria-labelledby="saved-tab" hidden>
      <div class="kcv-panel kcv-manager">
        <div class="kcv-section-head"><div><h2>Thư viện CV của tôi</h2><p class="kcv-help">Các hồ sơ riêng biệt theo công ty, lưu trong vùng dữ liệu ứng dụng của Google Drive.</p></div><button type="button" id="kcv-refresh" class="kcv-btn kcv-btn-secondary" disabled>Làm mới</button></div>
        <label class="kcv-choose">Chọn phiên bản CV đã lưu
          <select id="kcv-select" aria-label="Chọn CV đã lưu"><option value="">Chưa có CV · Kết nối Google để tải danh sách</option></select>
        </label>
        <div class="kcv-library-actions">
          <button type="button" id="kcv-open" class="kcv-btn kcv-btn-primary" disabled>Mở chỉnh sửa</button>
          <button type="button" id="kcv-copy" class="kcv-btn kcv-btn-secondary" disabled>Nhân bản cho công ty khác</button>
          <button type="button" id="kcv-remove" class="kcv-btn kcv-btn-danger" disabled>Xóa CV</button>
        </div>
      </div>
      <div class="kcv-panel">
        <h2>Kết quả đã lưu trên Google Drive</h2>
        <p>Chọn phiên bản được lưu trong Google Drive. Xuất PDF A4 hoặc Excel từ bản đã lưu; dữ liệu đang nhập chưa lưu sẽ không được xuất.</p>
        <p id="saved-empty" class="kcv-empty">Chưa có bản CV đã lưu.</p>
        <div class="kcv-actions" id="kcv-export-actions"></div>
      </div>
      <div class="kcv-panel" id="temporary-review" hidden><h2>Xem trước hồ sơ · Chưa lưu</h2><p class="kcv-help">Bản xem trước chỉ hiển thị trong phiên này. Để lưu, hãy kết nối Google và chọn Lưu CV.</p><div id="temporary-preview" class="kcv-preview-readable"></div></div>
    </section>
    <p class="kcv-reference">Tham khảo cấu trúc từ <a href={withBase('/bai-viet/giai-ma-ho-so-samsung-heavy-industries-resume-han-quoc/')}>bài phân tích hồ sơ Hàn Quốc</a>. Mẫu lịch sử không phải biểu mẫu tuyển dụng chính thức hiện hành.</p>
  </div>
  <script>import '../../../scripts/korea-cv-sync.ts'; import '../../../scripts/korea-cv-pdf.ts'; import '../../../scripts/korea-cv-xlsx.ts'; import '../../../scripts/korea-cv-preview.ts';</script>
</BaseLayout>
<script>
  const q = (selector: string) => document.querySelector(selector) as HTMLElement | null;
  const inputTab = q('#input-tab') as HTMLButtonElement;
  const savedTab = q('#saved-tab') as HTMLButtonElement;
  const inputPanel = q('#input-panel') as HTMLElement;
  const savedPanel = q('#saved-panel') as HTMLElement;
  function tab(toSaved: boolean) {
    inputPanel.hidden = toSaved;
    savedPanel.hidden = !toSaved;
    inputTab.setAttribute('aria-selected', String(!toSaved));
    savedTab.setAttribute('aria-selected', String(toSaved));
    (toSaved ? savedTab : inputTab).focus();
  }
  inputTab?.addEventListener('click', () => tab(false));
  savedTab?.addEventListener('click', () => tab(true));
  for (const add of document.querySelectorAll<HTMLButtonElement>('[data-add]')) add.addEventListener('click', () => {
    const id = add.dataset.add!;
    const container = document.querySelector<HTMLElement>(`[data-rows="${id}"]`)!;
    const fields = JSON.parse(container.dataset.fields!) as [string,string][];
    container.querySelector('.kcv-empty')?.remove();
    const row = document.createElement('div'); row.className = 'kcv-row';
    const grid = document.createElement('div'); grid.className = 'kcv-fields';
    for (const [key, label] of fields) {
      const wrapper = document.createElement('label'); wrapper.textContent = label;
      const control = key === 'description' || key === 'actions' || key === 'results' || key === 'responsibilities' || key === 'context' ? document.createElement('textarea') : document.createElement('input');
      control.setAttribute('data-field', key); control.setAttribute('autocomplete','off');
      wrapper.append(control); grid.append(wrapper);
    }
    const remove = document.createElement('button'); remove.type = 'button'; remove.textContent='Xóa dòng'; remove.className='kcv-remove';
    remove.addEventListener('click',()=>{row.remove(); if(!container.querySelector('.kcv-row')){const p=document.createElement('p');p.className='kcv-empty';p.textContent='Chưa có dữ liệu. Chọn “Thêm dòng”.';container.append(p);}});
    row.append(grid,remove); container.append(row);
  });
  q('#review-input')?.addEventListener('click',()=>{
    const container=q('#temporary-preview')!;
    container.replaceChildren();
    const heading=(text:string)=>{const h=document.createElement('h3');h.textContent=text;container.append(h);};
    const row=(name:string,value:string)=>{
      const line=document.createElement('div');line.className='kcv-preview-line';
      const dt=document.createElement('strong');dt.textContent=name;
      const dd=document.createElement('span');dd.textContent=value.trim()||'Chưa nhập';
      line.append(dt,dd);container.append(line);
    };
    heading('Thông tin ứng tuyển');
    for(const field of document.querySelectorAll<HTMLInputElement|HTMLSelectElement>('#cv-application [name]')){
      row(field.closest('label')?.textContent?.trim()||field.name,field.value);
    }
    for(const panel of document.querySelectorAll<HTMLElement>('#input-panel [data-section]')){
      const headingText=panel.querySelector('h2')?.textContent||'Thông tin';
      heading(headingText);
      if(panel.dataset.section==='personal'){
        panel.querySelectorAll<HTMLInputElement>('[name]').forEach(field=>
          row(field.closest('label')?.textContent?.trim()||field.name,field.value)
        );
        continue;
      }
      const entries=panel.querySelectorAll<HTMLElement>('.kcv-row');
      if(!entries.length){row('Dữ liệu','Chưa thêm');continue;}
      entries.forEach((entry,index)=>{
        const fields=entry.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]');
        heading('Mục '+(index+1));
        fields.forEach(field=>row(field.closest('label')?.textContent?.trim()||field.dataset.field||'',field.value));
      });
    }
    heading('Tự giới thiệu');
    document.querySelectorAll<HTMLTextAreaElement>('#cv-essays textarea').forEach(field=>
      row(field.closest('label')?.textContent?.trim()||field.name,field.value)
    );
    const review=q('#temporary-review')!;review.hidden=false;
    tab(true);review.scrollIntoView({block:'start'});
  });
</script>
<style>
  .kcv{--cv-ink:var(--ink);--cv-muted:var(--muted);--cv-line:var(--line);--cv-mint:#d5efd9;--cv-sky:#d6e9fb;--cv-peach:#f7d8ca;max-width:1120px;padding-block:24px 84px;color:var(--cv-ink)}
  .kcv nav{font-size:.85rem;color:var(--cv-muted)}.kcv nav a{color:var(--accent)}
  .kcv-head{margin:18px 0 22px}.kcv-head h1{font-size:clamp(2.15rem,4.2vw,3.7rem);letter-spacing:-.055em;line-height:1.12;margin:8px 0 12px;color:var(--cv-ink);text-wrap:balance}.kcv-head h1 span{color:var(--accent)}.kcv-head p{max-width:70ch;color:var(--cv-muted);font-size:1rem;line-height:1.65;margin:0}.kcv-head p.kcv-privacy{font-size:.8rem;margin-top:5px;color:var(--muted)}
  .kcv-tabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0 14px}.kcv-tabs button{background:var(--soft);border:1px solid var(--cv-line);border-radius:12px;padding:15px 12px;font-size:.95rem;font-weight:750;color:var(--cv-muted);cursor:pointer;min-height:56px;transition:background .15s,border-color .15s}.kcv-tabs button[aria-selected=true]{background:var(--cv-mint);border-color:#a1caab;color:var(--ink);box-shadow:inset 0 -3px var(--accent)}.kcv-tab-step{display:inline-grid;place-items:center;width:29px;height:29px;margin-right:8px;border-radius:50%;background:#fff8;font-size:.78rem}
  .kcv-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;column-gap:20px;row-gap:12px;background:#d6e9fb;border:1px solid #c5d8e6;border-radius:12px;padding:17px 20px;margin-bottom:21px;box-shadow:none}
  .kcv-toolbar-heading{display:flex;align-items:center;gap:11px;min-width:210px}.kcv-toolbar-heading strong{display:block;font-size:.94rem}.kcv-toolbar-heading small{display:block;color:var(--cv-muted);font-size:.77rem;margin-top:2px}.kcv-drive-icon{background:var(--white);border:1px solid var(--line);color:var(--accent);border-radius:10px;display:grid;place-items:center;font-size:22px;width:43px;height:43px;flex:none}
  .kcv-toolbar-actions,.kcv-library-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.kcv-btn{font:inherit;font-size:.85rem;font-weight:750;line-height:1.35;border-radius:10px;padding:11px 15px;border:1px solid transparent;min-height:44px;cursor:pointer;transition:transform .15s,background .15s}.kcv-btn:not(:disabled):active{transform:translateY(1px)}.kcv-btn-primary{background:var(--ink);color:var(--white);border-color:var(--ink)}.kcv-btn-primary:hover{background:var(--accent);border-color:var(--accent);color:white}.kcv-btn-secondary{background:var(--white);color:var(--ink);border-color:#cac9c5}.kcv-btn-secondary:hover{background:var(--soft)}.kcv-btn-accent{background:var(--accent);color:white;border-color:var(--accent)}.kcv-btn-accent:hover{background:#8b3821}.kcv-btn-danger{background:var(--cv-peach);color:#73331e;border-color:#e8b6a3}.kcv-btn:disabled{opacity:.48;cursor:not-allowed}.kcv-btn[hidden]{display:none!important}
  .kcv-status{display:flex;align-items:center;gap:8px;margin:1px 0 0;flex-basis:100%;font-size:.8rem;line-height:1.5;color:var(--ink)}.kcv-status[data-state=error]{color:#8d3026}.kcv-status[data-state=success]{color:#235d38}.kcv-status[data-state=info]{color:#304f78}.kcv-status-dot{width:8px;height:8px;flex:none;border-radius:50%;background:var(--accent)}.kcv-status[data-state=error] .kcv-status-dot{background:#bf4a35}.kcv-status[data-state=success] .kcv-status-dot{background:#3e8454}.kcv-status[data-state=info] .kcv-status-dot{background:#467ca1}
  .kcv-panel{background:#fff;border:1px solid var(--cv-line);border-radius:var(--radius);padding:clamp(17px,2.6vw,28px);margin:16px 0;box-shadow:none}.kcv-panel[data-section=education],.kcv-panel[data-section=projects],.kcv-panel[data-section=languages],.kcv-panel[data-section=training],.kcv-panel[data-section=research]{background:var(--cv-sky)}.kcv-panel[data-section=employment],.kcv-panel[data-section=certifications],.kcv-panel[data-section=skills],.kcv-panel[data-section=awards],.kcv-panel[data-section=referees]{background:#f5f4fc}.kcv-panel h2{font-size:1.08rem;margin:0 0 15px;color:var(--cv-ink)}
  .kcv-section-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px}.kcv-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
  .kcv-fields label,.kcv-essays label,.kcv-choose{display:flex;flex-direction:column;gap:7px;font-size:.84rem;font-weight:700;color:var(--ink)}
  .kcv-fields input,.kcv-fields select,.kcv-fields textarea,.kcv-essays textarea,.kcv-choose select{width:100%;min-width:0;border:1px solid #bbbcb9;border-radius:10px;padding:12px 13px;font:inherit;background:#fff;color:var(--ink);line-height:1.5}.kcv-fields input:focus,.kcv-essays textarea:focus,.kcv-choose select:focus{border-color:var(--accent)}
  .kcv-essays{display:grid;gap:14px}.kcv-rows{display:grid;gap:13px}.kcv :global(.kcv-row){padding:15px;border:1px solid var(--line);border-radius:12px;background:#fff}.kcv-empty{color:var(--cv-muted)}.kcv-add,.kcv-remove,.kcv-actions button{border:1px solid #e8b6a3;background:var(--cv-peach);color:#713921;border-radius:10px;padding:11px 14px;font-weight:750;cursor:pointer}.kcv :global(.kcv-remove){background:var(--cv-peach);color:#923a2b;margin-top:10px}.kcv-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:19px 0}.kcv-actions span{color:var(--cv-muted);font-size:.81rem}.kcv-actions button:disabled{opacity:.5;cursor:not-allowed}
  .kcv-help{color:var(--cv-muted);font-size:.83rem;margin:0 0 14px;line-height:1.6}.kcv-choose{margin:12px 0 14px}.kcv-library-actions{margin-top:12px}.kcv :global(#kcv-saved-preview){border:1px solid #d6e9de;border-radius:var(--radius);padding:22px;margin:16px 0}.kcv :global(.kcv-summary-grid){display:grid;grid-template-columns:minmax(100px,1fr) minmax(0,2fr);gap:6px 14px;overflow-wrap:break-word}.kcv :global(.kcv-summary-grid dt){font-weight:750}.kcv :global(.kcv-summary-grid dd){margin:0}.kcv :global(.kcv-summary-section){padding:12px 0;border-top:1px solid var(--cv-line)}.kcv :global(.kcv-summary-section p){white-space:pre-wrap;overflow-wrap:break-word}
  .kcv-reference{font-size:.84rem;color:var(--cv-muted);line-height:1.6}.kcv :is(button,input,select,textarea,a):focus-visible{outline:3px solid var(--accent);outline-offset:3px}#temporary-json{white-space:pre-wrap;overflow-wrap:break-word;max-height:500px;overflow:auto;font-size:.72rem}
  @media(max-width:760px){.kcv-toolbar{align-items:stretch}.kcv-toolbar-actions{width:100%}.kcv-toolbar-actions .kcv-btn{flex:1 1 auto}}
