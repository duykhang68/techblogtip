---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/content';
const colors = [
  {name:'Ink',hex:'#191b20',token:'--ink'},
  {name:'Muted',hex:'#667078',token:'--muted'},
  {name:'Paper',hex:'#fbfaf8',token:'--paper'},
  {name:'White',hex:'#ffffff',token:'--white'},
  {name:'Line',hex:'#e6e5e1',token:'--line'},
  {name:'Accent',hex:'#ad492c',token:'--accent'},
  {name:'Soft',hex:'#f3f1eb',token:'--soft'},
];
const pastels = [
  {name:'Sunny',hex:'#fce6ad'}, {name:'Lavender',hex:'#dfdcfa'},
  {name:'Mint',hex:'#d5efd9'}, {name:'Sky',hex:'#d6e9fb'},
  {name:'Peach',hex:'#f7d8ca'}, {name:'Steel',hex:'#e2e6e8'}
];
const rules = [
  {num:'01',title:'Content first',desc:'Ưu tiên khả năng đọc, tìm kiếm và nội dung thật. Không tạo hero/banner trang trí trên bất kỳ trang nào; đưa nội dung và thao tác chính lên đầu.'},
  {num:'02',title:'Vietnamese typography',desc:'Tiêu đề bài viết sử dụng hết chiều rộng vùng chứa, canh trái và xuống dòng tự nhiên. Tagline canh đều hợp lý ở desktop, canh trái trên mobile; tuyệt đối không bẻ từ hay kéo giãn khoảng trắng.'},
  {num:'03',title:'Mobile first',desc:'Bắt đầu từ 320px. Không tràn ngang, không cắt tiêu đề, thao tác dễ chạm và luôn có lối thoát.'},
  {num:'04',title:'Explain with visuals',desc:'Mỗi bài dài phải có bản đồ nội dung và sơ đồ giải thích theo chủ đề, ưu tiên SVG tĩnh và WebP.'},
  {num:'05',title:'Accessible by default',desc:'Đủ tương phản, focus-visible rõ ràng, semantic landmarks, alt text và điều hướng bằng bàn phím.'},
  {num:'06',title:'Ship with proof',desc:'Draft PR → kiểm định → FIFO merge → deploy đúng SHA. Không công bố đã lên production nếu chưa xác minh.'}
];
---
<BaseLayout title="Branding Guidelines" description="Bộ nhận diện thương hiệu, design tokens, typography, layout, component và quy tắc AI agent của TechBlogTip." canonicalPath={withBase('/branding/')}>
  <div class="container brandguide">
    <nav class="breadcrumb" aria-label="Đường dẫn"><a href={withBase('/')}>Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Branding Guidelines</span></nav>
    <header class="guide-intro">
      <h1 id="brandguide-title">Branding Guidelines</h1>
      <p>Quy chuẩn UI, UX, typography và layout dành cho TechBlogTip và AI agents.</p>
      <a href="https://github.com/duykhang68/techblogtip/blob/main/docs/BRANDING.md">Đọc quy chuẩn Markdown ↗</a>
    </header>
    <nav class="guide-toc" aria-label="Mục lục branding"><a href="#identity">01 Identity</a><a href="#palette">02 Colors</a><a href="#typography">03 Type</a><a href="#layout">04 Layout</a><a href="#components">05 Components</a><a href="#agent-contract">06 AI contract</a></nav>
    <section id="identity" class="guide-section"><div class="guide-heading"><span>01 / BRAND</span><h2>Nhận diện & tinh thần</h2></div><div class="guide-two"><div class="guide-panel guide-identity"><div class="guide-logo"><span class="guide-logo-mark">T<b>·</b></span><strong>TECHBLOGTIP</strong></div><p>Thủ thuật dễ làm, kiến thức dễ hiểu, công nghệ cho mọi người.</p></div><div class="guide-panel guide-manifesto"><h3>Editorial clarity.<br />Technical precision.</h3><p>Ấm áp nhưng chính xác; hiện đại nhưng dễ đọc. Nội dung luôn dẫn đường, màu pastel và biểu đồ hỗ trợ khả năng hiểu — không tranh sự chú ý.</p></div></div></section>
    <section id="palette" class="guide-section"><div class="guide-heading"><span>02 / COLOR</span><h2>Color tokens</h2><p>Các mã bên dưới được đối chiếu trực tiếp từ CSS của blog. Màu pastel dành cho nền và minh họa; chữ thông tin phải có độ tương phản đủ tốt.</p></div><div class="guide-swatches">{colors.map(color => <div class="guide-swatch"><div class="guide-color" style={`background:${color.hex}`}></div><strong>{color.name}</strong><code>{color.hex}</code><small>{color.token}</small></div>)}</div><h3 class="guide-subhead">Supporting pastels</h3><div class="guide-swatches guide-pastels">{pastels.map(color => <div class="guide-swatch"><div class="guide-color" style={`background:${color.hex}`}></div><strong>{color.name}</strong><code>{color.hex}</code></div>)}</div></section>
    <section id="typography" class="guide-section"><div class="guide-heading"><span>03 / TYPE</span><h2>Typography & bài đọc</h2></div><div class="guide-type-samples"><div class="guide-type-main"><small>FONT FAMILY — BE VIETNAM PRO</small><div class="guide-big-type">Aa<span>Ăă Ââ Êê</span></div><p>Tiếng Việt đẹp khi xuống dòng tự nhiên.</p></div><div class="guide-type-list"><div><small>DISPLAY / RESPONSIVE</small><h3>Tri thức được thiết kế để dễ hiểu.</h3></div><div><small>BODY / 15PX · 1.65</small><p>TechBlogTip ưu tiên nhịp đọc thoáng, cấu trúc rõ ràng và tương phản ổn định. Tiêu đề bài viết tận dụng toàn bộ chiều ngang vùng chứa và xuống dòng tự nhiên, không ép các dòng dài bằng nhau. Tagline canh đều có kiểm soát trên desktop, canh trái trên mobile; không chèn khoảng trắng hoặc ngắt từ tiếng Việt một cách gượng ép.</p></div><div><small>LABEL / COMPACT UI</small><span class="guide-chip">Khám phá</span> <span class="guide-chip">Đọc bài</span></div></div></div></section>
    <section id="layout" class="guide-section"><div class="guide-heading"><span>04 / LAYOUT</span><h2>Grid, spacing & responsive</h2></div><div class="guide-two"><div class="guide-panel"><h3>Mobile first</h3><div class="guide-devices" aria-hidden="true"><div class="guide-desktop"><span></span><div><i></i><i></i><i></i></div></div><div class="guide-phone"><span></span><i></i><i></i></div></div><p>Kiểm tra 320 · 375 · 768 · 1024 · 1440px. Không tràn ngang, không ép sidebar vào bài đọc và không cắt tiêu đề.</p></div><div class="guide-panel guide-layout-spec"><h3>Design measurements</h3><dl><div><dt>Container max</dt><dd>1440px</dd></div><div><dt>Gutter</dt><dd>16px / side</dd></div><div><dt>Global radius</dt><dd>12px</dd></div><div><dt>Card image</dt><dd>1 : 1</dd></div><div><dt>Body line-height</dt><dd>1.65</dd></div><div><dt>Article line-height</dt><dd>1.88</dd></div></dl></div></div></section>
    <section id="components" class="guide-section"><div class="guide-heading"><span>05 / UI KIT</span><h2>Components & states</h2><p>Với công cụ nhập liệu như Korea CV Maker: nút phải được định dạng ngay khi tải trang, nhãn dễ hiểu, thao tác trên mobile từ 320px và trạng thái Google Drive chỉ báo thành công sau khi xác thực thực tế. Bản xem trước cần trình bày trường dữ liệu dễ đọc, không hiển thị JSON kỹ thuật.</p></div><div class="guide-two"><div class="guide-panel guide-component-preview"><h3>Buttons & interactive controls</h3><div class="guide-actions"><a class="guide-primary" href={withBase('/tim-kiem/')}>Tìm bài viết ↗</a><a class="guide-secondary" href={withBase('/')}>Trang chủ</a></div><div class="guide-inline"><span class="guide-chip">Nhãn chủ đề</span><span class="guide-pill">● Đang đọc</span></div><p>Mọi trạng thái tương tác phải có focus rõ, khả năng thoát và nhãn truy cập.</p></div><div class="guide-panel guide-visual-preview"><div class="guide-preview-square"><span>ENGINEERING</span><strong>Visual<br />stories.</strong><svg viewBox="0 0 200 100" aria-hidden="true"><path d="M10 70 Q55 -5 100 54 T190 24" fill="none" stroke="#191b20" stroke-width="3"/><circle cx="100" cy="54" r="8" fill="#ad492c"/></svg></div><p>Hình 1:1, minh họa pastel, SVG có nội dung và ảnh WebP có alt text.</p></div></div></section>
    <section id="agent-contract" class="guide-section"><div class="guide-heading"><span>06 / AI HANDOFF</span><h2>Contract dành cho AI agents</h2><p>Trước khi sửa giao diện, agent phải đọc bản Markdown cùng AGENTS.md và các component đang chạy. Không tự suy diễn palette hay deploy.</p></div><div class="guide-contract"><div class="guide-contract-head"><span>IMPLEMENTATION CHECKLIST</span><a href="https://github.com/duykhang68/techblogtip/blob/main/docs/BRANDING.md">docs/BRANDING.md ↗</a></div><ol>{rules.map(rule => <li><span>{rule.num}</span><div><strong>{rule.title}</strong><p>{rule.desc}</p></div></li>)}</ol></div><div class="guide-security"><strong>Security baseline</strong><p>Không đưa token, API key, session, service account, file .env thật hoặc bản sao dữ liệu riêng tư vào Git/public. Kiểm tra .gitignore, file đã tracked và CI trước khi đưa PR lên.</p></div></section>
  </div>
</BaseLayout>
<style>
.brandguide{padding-block:24px 92px}.guide-intro{display:flex;align-items:baseline;flex-wrap:wrap;gap:10px 24px;padding:12px 0 22px}.guide-intro h1{font-size:clamp(1.45rem,2.6vw,2.2rem);line-height:1.25;letter-spacing:-.035em}.guide-intro p{font-size:.92rem;color:var(--muted);line-height:1.6;flex:1 1 290px}.guide-intro a{font-size:.83rem;font-weight:750;color:var(--accent)}.guide-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:27px}.guide-primary,.guide-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:12px 18px;border-radius:10px;font-size:.85rem;font-weight:750}.guide-primary{background:var(--ink);color:white}.guide-primary:hover{color:#fff;background:var(--accent)}.guide-secondary{border:1px solid #d4d2cc;background:white}
.guide-toc{display:flex;gap:8px;flex-wrap:wrap;border-block:1px solid var(--line);padding-block:15px}.guide-toc a{font-size:.79rem;font-weight:700;padding:9px 12px;border-radius:30px;background:var(--white);border:1px solid var(--line)}.guide-toc a:hover{background:var(--soft)}.guide-section{padding-block:66px;border-bottom:1px solid var(--line);scroll-margin-top:95px}.guide-heading{max-width:800px;margin-bottom:26px}.guide-heading>span{font-size:.7rem;font-weight:800;color:var(--accent);letter-spacing:.14em}.guide-heading h2{font-size:clamp(1.8rem,3.3vw,3rem);margin-top:8px}.guide-heading p{margin-top:13px;color:var(--muted);line-height:1.75}.guide-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.guide-panel{padding:clamp(22px,3vw,40px);border:1px solid var(--line);background:white;border-radius:14px;min-width:0}.guide-panel h3{font-size:clamp(1.25rem,2vw,1.8rem)}.guide-panel p{color:var(--muted);line-height:1.8;margin-top:16px}.guide-identity{background:#fce6ad;border-color:#f6dc9a}.guide-logo{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:clamp(1rem,2vw,1.6rem);letter-spacing:-.06em}.guide-logo-mark{display:grid;place-items:center;background:var(--ink);color:white;width:56px;height:56px;border-radius:12px;font-size:2rem}.guide-logo-mark b{color:#fa8c50}.guide-manifesto{background:#d5efd9}.guide-swatches{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:13px}.guide-swatch{min-width:0;display:flex;flex-direction:column;gap:5px;font-size:.8rem}.guide-color{height:120px;border:1px solid rgba(0,0,0,.08);border-radius:12px;margin-bottom:7px}.guide-swatch strong{font-size:.84rem}.guide-swatch code{font-size:.76rem;overflow-wrap:anywhere}.guide-swatch small{color:var(--muted)}.guide-subhead{margin:32px 0 14px;font-size:1rem}.guide-pastels{grid-template-columns:repeat(6,minmax(0,1fr))}.guide-type-samples{display:grid;grid-template-columns:1fr 1fr;gap:18px}.guide-type-main{padding:clamp(22px,3vw,40px);background:#d6e9fb;border-radius:14px}.guide-type-main small,.guide-type-list small{font-size:.7rem;letter-spacing:.1em;font-weight:800}.guide-big-type{font-weight:800;font-size:clamp(4rem,8vw,8rem);letter-spacing:-.09em;line-height:1.2;margin-top:18px}.guide-big-type span{display:block;font-size:clamp(1.4rem,3vw,2.7rem);letter-spacing:-.05em}.guide-type-main p{margin-top:28px;font-size:1.1rem}.guide-type-list{display:flex;flex-direction:column;gap:20px}.guide-type-list>div{background:white;border:1px solid var(--line);border-radius:12px;padding:23px}.guide-type-list h3{font-size:clamp(1.4rem,2.2vw,2rem);margin-top:10px}.guide-type-list p{margin-top:10px;line-height:1.75;color:var(--muted)}.guide-chip,.guide-pill{display:inline-flex;padding:8px 12px;border:1px solid var(--line);border-radius:24px;background:#f3f1eb;font-size:.77rem;font-weight:700}.guide-pill{background:#d5efd9}.guide-devices{height:180px;position:relative;display:flex;align-items:center;justify-content:center}.guide-desktop{width:75%;height:126px;border:8px solid #191b20;border-bottom-width:16px;border-radius:9px;background:#d6e9fb;padding:15px}.guide-desktop>span{display:block;width:48%;height:12px;background:#ad492c;border-radius:3px}.guide-desktop>div{display:flex;gap:8px;margin-top:15px}.guide-desktop i{display:block;background:#fff;width:28%;height:53px;border-radius:5px}.guide-phone{position:absolute;right:8%;bottom:0;width:60px;height:116px;border:7px solid #191b20;border-radius:12px;background:#fce6ad;padding:11px 6px}.guide-phone span,.guide-phone i{display:block;background:#fff;height:16px;border-radius:3px;margin-bottom:7px}.guide-phone i{height:24px}.guide-layout-spec dl{margin:20px 0 0}.guide-layout-spec dl div{display:flex;justify-content:space-between;gap:14px;border-bottom:1px solid var(--line);padding:12px 0;font-size:.87rem}.guide-layout-spec dt{color:var(--muted)}.guide-layout-spec dd{margin:0;font-weight:800}.guide-inline{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.guide-visual-preview{background:#f7d8ca}.guide-preview-square{aspect-ratio:1.5;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative;border-radius:12px;background:#dfdcfa;padding:23px}.guide-preview-square>span{font-size:.69rem;font-weight:800;letter-spacing:.12em}.guide-preview-square strong{font-size:clamp(2rem,4vw,3.5rem);line-height:1;letter-spacing:-.06em;position:relative;z-index:1}.guide-preview-square svg{position:absolute;right:0;bottom:0;width:48%;opacity:.9}.guide-contract{border:1px solid var(--line);background:white;border-radius:14px;overflow:hidden}.guide-contract-head{padding:20px 25px;background:#e2e6e8;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:.75rem;font-weight:800}.guide-contract-head a{color:var(--accent)}.guide-contract ol{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.guide-contract li{display:flex;gap:15px;padding:25px;border-bottom:1px solid var(--line);min-width:0}.guide-contract li:nth-child(odd){border-right:1px solid var(--line)}.guide-contract li>span{color:var(--accent);font-weight:800;font-size:.77rem}.guide-contract li strong{font-size:1rem}.guide-contract li p{color:var(--muted);line-height:1.65;font-size:.87rem;margin-top:7px}.guide-security{padding:25px;margin-top:18px;border-radius:13px;background:#fce6ad}.guide-security strong{font-size:1rem}.guide-security p{margin-top:9px;line-height:1.7;font-size:.9rem}
@media(max-width:900px){.guide-type-samples{grid-template-columns:1fr}.guide-swatches{grid-template-columns:repeat(4,minmax(0,1fr))}.guide-pastels{grid-template-columns:repeat(3,minmax(0,1fr))}.guide-color{height:90px}}
@media(max-width:650px){.brandguide{padding-top:18px}.guide-intro{align-items:flex-start;gap:8px}.guide-intro p{flex-basis:100%}.guide-section{padding-block:43px}.guide-two,.guide-contract ol{grid-template-columns:1fr}.guide-contract li:nth-child(odd){border-right:0}.guide-swatches{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-pastels{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-color{height:95px}.guide-actions>*{flex:1}.guide-toc{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:thin}.guide-toc a{flex:none}.guide-type-list>div{padding:18px}}
</style>