---
// Scoped presentation enhancement for one editorial article.
// All information-bearing charts and calculator defaults are authored in Markdown.
// No external dependencies, APIs, persistent storage or backend requests.
---
<style is:global>
.prose :is(.econ-kpis,.econ-weights,.econ-ranking,.econ-target,.econ-calculator,.econ-channels,.econ-funnel,.econ-decision){margin:1.15rem 0 2rem;line-height:1.5;text-align:left;word-break:normal;overflow-wrap:normal;hyphens:none}
.prose :is(.econ-kpis,.econ-weights,.econ-ranking,.econ-target,.econ-calculator,.econ-channels,.econ-funnel,.econ-decision) :is(p,small,span,strong,li,div){text-align:left!important;text-wrap:wrap;word-break:normal;overflow-wrap:normal;hyphens:none}
.econ-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}
.econ-kpi{border:1px solid #e6e5e1;padding:1rem .85rem;border-radius:12px;min-width:0;display:flex;flex-direction:column;gap:.35rem}
.econ-lavender{background:#f4f0fe}.econ-sky{background:#eff7ff}.econ-mint{background:#eff9f0}
.econ-kpi small{font-size:.7rem;line-height:1.5;color:#4b5665}
.econ-kpi strong{font-size:clamp(1.45rem,3.4vw,2.15rem);color:#25344f;line-height:1.1;letter-spacing:-.05em;font-variant-numeric:tabular-nums}
.econ-kpi span{font-size:.67rem;line-height:1.5;color:#5a6672}
.econ-weights{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.5rem}
.econ-weights>div{min-width:0;display:flex;flex-direction:column;gap:.4rem;padding:.65rem .55rem;border-radius:10px;border-top:6px solid var(--tone);background:#fff;border-left:1px solid #eeece7;border-right:1px solid #eeece7;border-bottom:1px solid #eeece7}
.econ-weights strong{color:#263447;font-size:1.22rem;font-variant-numeric:tabular-nums}
.econ-weights span{color:#52606d;font-size:.69rem;line-height:1.5}
.econ-ranking,.econ-target,.econ-calculator{background:#fff;border:1px solid #e6e5e1;border-radius:14px;padding:1.1rem}
.econ-figure-label{font-size:.8rem;font-weight:800;line-height:1.5;letter-spacing:-.015em;margin-bottom:.9rem;color:#273341}
.econ-ranking ol{margin:0!important;padding:0!important;list-style:none!important;display:flex;flex-direction:column;gap:.8rem}
.econ-ranking li{list-style:none!important;margin:0!important;min-width:0}
.econ-ranking li>div{display:flex;align-items:baseline;gap:.6rem;margin-bottom:.3rem;font-size:.78rem}
.econ-ranking strong{font-weight:800;min-width:0}
.econ-ranking li small{font-size:.65rem;color:#667078}
.econ-ranking li b{margin-left:auto;font-size:.8rem;font-variant-numeric:tabular-nums;color:#263447}
.econ-bar{display:block;background:#f3f1eb;border-radius:99px;overflow:hidden;height:13px;width:100%}
.econ-bar i{display:block;width:var(--w);height:100%;background:var(--tint);border-right:3px solid #5b6476;border-radius:99px}
.econ-ranking>p,.econ-target>p{color:#667078;font-size:.72rem!important;line-height:1.65;margin:.9rem 0 0!important;text-align:left!important}
.econ-target-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.5rem}
.econ-target-card{display:flex;min-width:0;flex-direction:column;align-items:start;gap:.25rem;padding:.75rem .55rem;background:#f8f7f4;border-radius:10px}
.econ-target-card:nth-child(2){background:#eff8f1}.econ-target-card:nth-child(3){background:#f4f0fe}.econ-target-card:nth-child(4){background:#fff6e6}.econ-target-card:nth-child(5){background:#fff0e9}
.econ-target-card small{color:#52606b;font-size:.64rem;line-height:1.4;min-height:2.6em}
.econ-target-card strong{color:#293d51;font-size:clamp(1.35rem,3vw,2rem);font-variant-numeric:tabular-nums;line-height:1.1}
.econ-target-card span{color:#62707d;font-size:.63rem;line-height:1.5}
.econ-calc-top{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1rem}
.econ-calc-top strong{font-size:.92rem;color:#273447}.econ-calc-top span{font-size:.68rem;color:#667078;letter-spacing:.03em}
.econ-controls{display:grid;gap:.48rem}
.econ-controls label{color:#42515f;font-size:.72rem;font-weight:750}
.econ-controls :is(select,input[type="range"]){width:100%;min-width:0;accent-color:#ad492c}
.econ-controls select{font:inherit;font-size:.84rem;min-height:44px;border:1px solid #cfd3d6;border-radius:8px;background:#fbfaf8;padding:.55rem .65rem;color:#1e2937}
.econ-controls input[type="range"]{min-height:35px;cursor:pointer}
.econ-control-label{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:.2rem}
.econ-control-label output{font-weight:900;font-size:.93rem;font-variant-numeric:tabular-nums;color:#25344f}
.econ-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-top:1rem}
.econ-results>div{display:flex;min-width:0;flex-direction:column;gap:.25rem;background:#d6e9fb;padding:.85rem;border-radius:10px}
.econ-results>div:nth-child(2){background:#d5efd9}
.econ-results small{font-size:.7rem;color:#3d4c5b}
.econ-results output{font-size:clamp(1.45rem,3vw,1.95rem);font-weight:900;color:#25344f;font-variant-numeric:tabular-nums;letter-spacing:-.035em}
.econ-calculator>p{font-size:.74rem;color:#52606b;line-height:1.65;margin:.85rem 0 .5rem!important;text-align:left!important}
.econ-disclaimer{display:block;font-size:.68rem;line-height:1.65;color:#697581}
.econ-channels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}
.econ-channels>div{display:flex;flex-direction:column;gap:.3rem;border:1px solid #e6e5e1;border-left:5px solid #d6e9fb;border-radius:10px;background:#fff;padding:.85rem}
.econ-channels>div:nth-child(2){border-left-color:#d5efd9}.econ-channels>div:nth-child(3){border-left-color:#dfdcfa}.econ-channels>div:nth-child(4){border-left-color:#fce6ad}.econ-channels>div:nth-child(5){border-left-color:#f7d8ca}
.econ-channels strong{font-size:.8rem;color:#293744}
.econ-channels span{font-size:.7rem;line-height:1.6;color:#5f6872}
.econ-funnel{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem}
.econ-funnel>div{position:relative;min-width:0;border:1px solid #e6e5e1;border-radius:11px;padding:.85rem .65rem;display:flex;flex-direction:column;gap:.4rem;background:#fff}
.econ-funnel>div:nth-child(1){background:#eff7ff}.econ-funnel>div:nth-child(2){background:#f4f0fe}.econ-funnel>div:nth-child(3){background:#fff9ec}.econ-funnel>div:nth-child(4){background:#eff9f0}
.econ-funnel>div>span{font-size:.63rem;color:#8f5b47;font-weight:900;letter-spacing:.07em}
.econ-funnel strong{font-size:.76rem;line-height:1.5;color:#273447}
.econ-funnel small{font-size:.67rem;line-height:1.5;color:#53606d}
.econ-decision{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}
.econ-decision>div{min-width:0;background:#fff;border:1px solid #e6e5e1;border-radius:12px;padding:.9rem}
.econ-decision>div:first-child{background:#eff7ff;grid-column:1/-1;border-left:5px solid #9ac7ee}
.econ-decision>div:nth-child(2){background:#f1f8ef}.econ-decision>div:nth-child(3){background:#f5f0fc}
.econ-decision span{display:block;font-size:.68rem;color:#596575;margin-bottom:.25rem}
.econ-decision strong{display:block;color:#263447;font-size:1.06rem}
.econ-decision p{font-size:.76rem;line-height:1.7;margin:.35rem 0 0!important;color:#495663;text-align:left!important}
@media(max-width:680px){
 .econ-weights{grid-template-columns:repeat(2,minmax(0,1fr))}
 .econ-weights>div:last-child{grid-column:1/-1}
 .econ-kpis{grid-template-columns:1fr}
 .econ-kpi{gap:.15rem}
 .econ-target-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .econ-target-card:last-child{grid-column:1/-1}
 .econ-funnel{grid-template-columns:repeat(2,minmax(0,1fr))}
 .econ-ranking,.econ-target,.econ-calculator{padding:.85rem}
 .econ-ranking li>div{flex-wrap:wrap}
}
@media(max-width:400px){
 .econ-channels,.econ-decision{grid-template-columns:1fr}
 .econ-decision>div:first-child{grid-column:1}
 .econ-results{grid-template-columns:1fr}
 .econ-ranking li small{width:100%}
}
</style>
<script is:inline>
(function(){
 function init(){
  const root=document.querySelector('[data-econ-calc]');
  if(!root)return;
  const app=root.querySelector('[data-econ-app]');
  const customers=root.querySelector('[data-econ-customers]');
  const fee=root.querySelector('[data-econ-fee]');
  const count=root.querySelector('[data-econ-count]');
  const unit=root.querySelector('[data-econ-unit]');
  const gross=root.querySelector('[data-econ-gross]');
  const net=root.querySelector('[data-econ-net]');
  const explain=root.querySelector('[data-econ-explain]');
  if(!app||!customers||!fee||!count||!unit||!gross||!net||!explain)return;
  const plans={
   release:{name:'ReleaseProof',price:9,period:'month'},
   field:{name:'FieldQuote',price:9.99,period:'month'},
   doc:{name:'DocFlow Pro',price:49,period:'once'},
   store:{name:'StoreLaunch QA',price:39,period:'year'},
   korea:{name:'Korea Pocket',price:19.99,period:'year'}
  };
  const fmt=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(n);
  function recalc(){
   const plan=plans[app.value]||plans.field;
   const n=Math.max(0,Number(customers.value)||0);
   const f=Math.min(100,Math.max(0,Number(fee.value)||0));
   const amount=n*plan.price/(plan.period==='year'?12:1);
   count.textContent=n.toLocaleString('en-US');
   gross.textContent=fmt(amount);
   net.textContent=fmt(amount*(1-f/100));
   unit.textContent=plan.period==='once'?'Giấy phép mới bán mỗi tháng':'Số thuê bao đang trả tiền';
   const basis=plan.period==='year'?'quy đổi bình quân theo 12 tháng':plan.period==='once'?'giấy phép mới giả định bán trong tháng':'thuê bao tháng';
   explain.textContent=n.toLocaleString('en-US')+' '+basis+' × '+fmt(plan.price)+(plan.period==='year'?' / năm':'')+'. Phần sau phí không phải lợi nhuận.';
  }
  for(const field of [app,fee]) field.addEventListener('change',recalc);
  customers.addEventListener('input',recalc);
  recalc();
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});
 else init();
})();
</script>
