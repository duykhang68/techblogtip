---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings } = Astro.props as { headings: Heading[] };
const visibleHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---

<aside class="article-aside" aria-label="Mục lục bài viết" data-smart-toc>
  <div class="smart-toc">
    <div class="smart-toc__header">
      <span class="section-kicker">TRONG BÀI NÀY</span>
      <span class="smart-toc__percent" data-reading-percent>0%</span>
    </div>
    <progress
      class="smart-toc__progress"
      data-reading-progress
      max="100"
      value="0"
      aria-label="Tiến độ đọc bài viết"
    >0%</progress>
    <nav class="smart-toc__nav" aria-label="Các mục trong bài viết">
      {visibleHeadings.map(heading => (
        <a
          class:list={['smart-toc__link', { 'is-sub': heading.depth === 3 }]}
          href={'#' + heading.slug}
          data-toc-link
        >{heading.text}</a>
      ))}
    </nav>
  </div>
</aside>

<script>
  const toc = document.querySelector<HTMLElement>('[data-smart-toc]');
  const article = document.getElementById('article-body');

  if (toc && article) {
    const progress = toc.querySelector<HTMLProgressElement>('[data-reading-progress]');
    const percentage = toc.querySelector<HTMLElement>('[data-reading-percent]');
    const sections = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'))
      .map(link => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => item.heading !== null);

    let pendingFrame = 0;

    const updateReadingPosition = () => {
      pendingFrame = 0;
      const articleRect = article.getBoundingClientRect();
      const articleTop = articleRect.top + window.scrollY;
      const articleBottom = articleRect.bottom + window.scrollY;
      // Read slightly below the fixed site header, not at the viewport's bottom.
      const readingLine = Math.min(240, Math.max(120, window.innerHeight * 0.28));
      const readingPosition = window.scrollY + readingLine;
      // With a reading line near the header, even scrolling to the absolute
      // document bottom can leave the line above the end of the article.
      // Complete when the article's end is visible or the reader reaches the
      // bottom of the document. Otherwise keep percentages strictly below 100.
      const viewportBottom = window.scrollY + window.innerHeight;
      const articleEndVisible = articleBottom <= viewportBottom - 48;
      const maxScrollY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const documentEndReached = window.scrollY > 0 && window.scrollY >= maxScrollY - 2;
      const computed = Math.round(
        Math.max(0, Math.min(100, (readingPosition - articleTop) / Math.max(1, articleBottom - articleTop) * 100))
      );
      const completion = articleEndVisible || documentEndReached ? 100 : Math.min(99, computed);

      if (progress) progress.value = completion;
      if (percentage) percentage.textContent = completion + '%';

      let activeIndex = -1;
      sections.forEach(({ heading }, index) => {
        if (heading.getBoundingClientRect().top <= readingLine + 1) activeIndex = index;
      });
      if (readingPosition >= articleBottom && sections.length) activeIndex = sections.length - 1;

      sections.forEach(({ link }, index) => {
        const active = index === activeIndex;
        link.classList.toggle('is-active', active);
        link.classList.toggle('is-read', index < activeIndex);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const requestUpdate = () => {
      if (!pendingFrame) pendingFrame = window.requestAnimationFrame(updateReadingPosition);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    window.addEventListener('hashchange', requestUpdate);
    // Deferred images and diagrams can change the article's height after load.
    if ('ResizeObserver' in window) new ResizeObserver(requestUpdate).observe(article);
    requestUpdate();
  }
</script>

<style>
  .smart-toc {
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }

  .smart-toc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .smart-toc__percent {
    color: var(--accent);
    font-size: .79rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .smart-toc__progress {
    display: block;
    width: 100%;
    height: 5px;
    margin-bottom: 12px;
    border: 0;
    border-radius: 99px;
    overflow: hidden;
    appearance: none;
    background: #eee6df;
  }

  .smart-toc__progress::-webkit-progress-bar {
    background: #eee6df;
    border-radius: 99px;
  }

  .smart-toc__progress::-webkit-progress-value {
    background: var(--accent);
    border-radius: 99px;
    transition: width .16s ease-out;
  }

  .smart-toc__progress::-moz-progress-bar {
    background: var(--accent);
    border-radius: 99px;
    transition: width .16s ease-out;
  }

  .smart-toc__nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .smart-toc__link {
    position: relative;
    display: block;
    padding: 5px 8px;
    border-radius: 7px;
    color: #62666b;
    font-size: .75rem;
    line-height: 1.55;
    transition: background-color .16s ease, color .16s ease;
    overflow-wrap: anywhere;
  }

  .smart-toc__link.is-sub { margin-left: 12px; }

  .smart-toc__link.is-read { color: #a36b54; }

  .smart-toc__link.is-active {
    background: #fff0e6;
    color: #9d3f23;
    font-weight: 750;
  }

  .smart-toc__link.is-active::before {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: -17px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
    content: '';
  }

  .smart-toc__link:hover {
    background: #fff5ed;
    color: var(--accent);
  }

  .smart-toc__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .smart-toc__link,
    .smart-toc__progress::-webkit-progress-value,
    .smart-toc__progress::-moz-progress-bar { transition: none; }
  }
</style>
